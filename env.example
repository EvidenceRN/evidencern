# Copy this file to .env and fill in your key. Never commit .env to git.

# Required for the synthesized answer, deep read, and follow-ups.
# Get a key: https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Optional. Model used for synthesis. Haiku-class models cost less per question.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Port for the local server.
PORT=3000
